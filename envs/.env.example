# ============================================================================
# LAKEHOUSE STACK - Template de configuration
# ============================================================================
# Copiez ce fichier vers envs/.env.{env} et modifiez les valeurs
# ============================================================================

# Environnement: dev | preprod | prod
ENV=dev
RESTART_POLICY=no

# ==========================================
# POSTGRESQL
# ==========================================
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=lakehouse
POSTGRES_PORT=5432

# ==========================================
# MINIO
# ==========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGEME
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
LAKEHOUSE_BUCKET=lakehouse
WAREHOUSE_BUCKET=warehouse

# ==========================================
# NESSIE
# ==========================================
NESSIE_PORT=19120

# ==========================================
# SPARK
# ==========================================
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ==========================================
# LIVY
# ==========================================
LIVY_PORT=8998

# ==========================================
# ZEPPELIN
# ==========================================
ZEPPELIN_PORT=8081

# ==========================================
# DREMIO
# ==========================================
DREMIO_UI_PORT=9047
DREMIO_CLIENT_PORT=31010
DREMIO_FLIGHT_PORT=32010

# ==========================================
# AIRFLOW
# ==========================================
AIRFLOW_PORT=8082
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME
AIRFLOW_FERNET_KEY=CHANGEME
AIRFLOW_SECRET_KEY=CHANGEME

# ==========================================
# PROMETHEUS
# ==========================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ==========================================
# GRAFANA
# ==========================================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME

# ==========================================
# SUPERSET
# ==========================================
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGEME
SUPERSET_SECRET_KEY=CHANGEME
