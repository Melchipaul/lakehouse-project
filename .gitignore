# ========================================
# Lakehouse Project - .gitignore
# ========================================

# Fichiers sensibles (IMPORTANT!)
.env
# Ignorer tous les .env sauf les exemples
envs/.env.dev
envs/.env.preprod
envs/.env.prod
!envs/.env.example
*.pem
*.key
*.p12
*.jks

# Docker volumes et données
docker/*/data/
**/data/
.volumes/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
venv/
.venv/
.python-version

# Jupyter
.ipynb_checkpoints/

# Spark
spark-warehouse/
metastore_db/
derby.log

# Zeppelin
**/zeppelin-conf/
**/zeppelin-notebooks/

# Node (si frontend)
node_modules/
npm-debug.log

# Build artifacts
dist/
build/
*.tar.gz
*.zip
