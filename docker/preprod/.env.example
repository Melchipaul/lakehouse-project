# ========================================
# Projet Lakehouse - Configuration PREPROD
# Décembre 2025 - Stack moderne avec Iceberg 1.7.0
# ========================================
# 
# IMPORTANT: Copier ce fichier vers .env et remplir les valeurs
# $ cp .env.example .env
# 
# ⚠️ Les ports sont décalés de +1000 par rapport à DEV
# pour permettre le fonctionnement simultané des environnements
# ========================================

# Environment
ENV=preprod

# ========================================
# PostgreSQL 17 (Backend métadonnées)
# ========================================
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=CHANGEME_PREPROD_SECURE_PASSWORD
POSTGRES_DB=lakehouse
POSTGRES_PORT=6432

# ========================================
# MinIO (S3-compatible storage)
# ========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGEME_PREPROD_SECURE_PASSWORD
MINIO_API_PORT=20000
MINIO_CONSOLE_PORT=20001
LAKEHOUSE_BUCKET=lakehouse-preprod
WAREHOUSE_BUCKET=warehouse-preprod

# ========================================
# Nessie (Git-like catalog for Iceberg)
# ========================================
NESSIE_PORT=20120

# ========================================
# Apache Spark 3.5.4 (Cluster standalone)
# ========================================
SPARK_MASTER_PORT=8077
SPARK_MASTER_UI_PORT=9080
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g

# ========================================
# Apache Livy (REST API for Spark)
# ========================================
LIVY_PORT=9998

# ========================================
# Apache Zeppelin 0.12.0 (Notebook UI)
# ========================================
ZEPPELIN_PORT=9081

# ========================================
# Dremio (SQL Query Engine)
# ========================================
DREMIO_UI_PORT=10047
DREMIO_CLIENT_PORT=41010
DREMIO_FLIGHT_PORT=42010

# ========================================
# Apache Airflow (Orchestration)
# ========================================
AIRFLOW_PORT=9082
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME_PREPROD_SECURE_PASSWORD
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGEME_GENERATE_FERNET_KEY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=CHANGEME_GENERATE_SECRET_KEY

# ========================================
# Prometheus & Grafana (Monitoring)
# ========================================
PROMETHEUS_PORT=10090
GRAFANA_PORT=4001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_PREPROD_SECURE_PASSWORD

# ========================================
# Apache Superset (BI & Visualization)
# ========================================
SUPERSET_PORT=9088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGEME_PREPROD_SECURE_PASSWORD
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERSET_SECRET_KEY=CHANGEME_GENERATE_SECRET_KEY

# ========================================
# Stack Versions (Information)
# ========================================
# - Spark: 3.5.4
# - Livy: custom build (Spark 3.5 profile)
# - Iceberg: 1.7.0
# - Nessie: latest
# - PostgreSQL: 17
# - Zeppelin: 0.12.0
# - Dremio OSS: latest
# - Airflow: 2.10.4
# - Prometheus/Grafana: latest
# - Superset: latest
# 
# ========================================
# URLs PREPROD (après démarrage)
# ========================================
# - MinIO Console:   http://localhost:20001
# - Spark Master UI: http://localhost:9080
# - Nessie API:      http://localhost:20120
# - Livy REST API:   http://localhost:9998
# - Zeppelin:        http://localhost:9081
# - Dremio:          http://localhost:10047
# - Airflow:         http://localhost:9082
# - Prometheus:      http://localhost:10090
# - Grafana:         http://localhost:4001
# - Superset:        http://localhost:9088
# 
# ========================================
