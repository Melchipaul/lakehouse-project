# ========================================
# Projet Lakehouse - Configuration PROD
# Décembre 2025 - Stack moderne avec Iceberg 1.7.0
# ========================================
# 
# IMPORTANT: Copier ce fichier vers .env et remplir les valeurs
# $ cp .env.example .env
# 
# ⚠️ Les ports sont décalés de +2000 par rapport à DEV
# pour permettre le fonctionnement simultané des environnements
# 
# ⚠️ PRODUCTION: Utiliser des mots de passe forts (32+ caractères)
# et des clés générées avec les commandes indiquées
# ========================================

# Environment
ENV=prod

# ========================================
# PostgreSQL 17 (Backend métadonnées)
# ========================================
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=CHANGEME_PROD_STRONG_PASSWORD_32CHARS
POSTGRES_DB=lakehouse
POSTGRES_PORT=7432

# ========================================
# MinIO (S3-compatible storage)
# ========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGEME_PROD_STRONG_PASSWORD_32CHARS
MINIO_API_PORT=21000
MINIO_CONSOLE_PORT=21001
LAKEHOUSE_BUCKET=lakehouse-prod
WAREHOUSE_BUCKET=warehouse-prod

# ========================================
# Nessie (Git-like catalog for Iceberg)
# ========================================
NESSIE_PORT=21120

# ========================================
# Apache Spark 3.5.4 (Cluster standalone)
# ========================================
# PROD: Plus de ressources pour le worker
SPARK_MASTER_PORT=9077
SPARK_MASTER_UI_PORT=10080
SPARK_WORKER_CORES=8
SPARK_WORKER_MEMORY=8g

# ========================================
# Apache Livy (REST API for Spark)
# ========================================
LIVY_PORT=10998

# ========================================
# Apache Zeppelin 0.12.0 (Notebook UI)
# ========================================
ZEPPELIN_PORT=10081

# ========================================
# Dremio (SQL Query Engine)
# ========================================
DREMIO_UI_PORT=11047
DREMIO_CLIENT_PORT=51010
DREMIO_FLIGHT_PORT=52010

# ========================================
# Apache Airflow (Orchestration)
# ========================================
AIRFLOW_PORT=10082
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME_PROD_STRONG_PASSWORD_32CHARS
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGEME_GENERATE_FERNET_KEY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=CHANGEME_GENERATE_SECRET_KEY

# ========================================
# Prometheus & Grafana (Monitoring)
# ========================================
PROMETHEUS_PORT=11090
GRAFANA_PORT=5001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_PROD_STRONG_PASSWORD_32CHARS

# ========================================
# Apache Superset (BI & Visualization)
# ========================================
SUPERSET_PORT=10088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGEME_PROD_STRONG_PASSWORD_32CHARS
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERSET_SECRET_KEY=CHANGEME_GENERATE_SECRET_KEY

# ========================================
# Stack Versions (Information)
# ========================================
# - Spark: 3.5.4
# - Livy: custom build (Spark 3.5 profile)
# - Iceberg: 1.7.0
# - Nessie: latest
# - PostgreSQL: 17
# - Zeppelin: 0.12.0
# - Dremio OSS: latest
# - Airflow: 2.10.4
# - Prometheus/Grafana: latest
# - Superset: latest
# 
# ========================================
# URLs PROD (après démarrage)
# ========================================
# - MinIO Console:   http://localhost:21001
# - Spark Master UI: http://localhost:10080
# - Nessie API:      http://localhost:21120
# - Livy REST API:   http://localhost:10998
# - Zeppelin:        http://localhost:10081
# - Dremio:          http://localhost:11047
# - Airflow:         http://localhost:10082
# - Prometheus:      http://localhost:11090
# - Grafana:         http://localhost:5001
# - Superset:        http://localhost:10088
# 
# ========================================
# CHECKLIST PRODUCTION
# ========================================
# [ ] Mots de passe forts (32+ caractères)
# [ ] Clés Fernet/Secret générées proprement
# [ ] SSL/TLS configuré (reverse proxy)
# [ ] Backup strategy en place
# [ ] Monitoring alertes configurées
# [ ] Accès réseau restreint
# [ ] Logs externalisés
# ========================================
